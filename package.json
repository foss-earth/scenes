    },
    "./panel.css": "./styles/panel.css",
    "./node": {
      "types": "./node/scene-check.d.mts",
      "import": "./node/scene-check.mjs"
    },
    "./check-cli": "./node/check-cli.mjs",
    "./preview-sheets": {
      "types": "./node/preview-sheets.d.mts",
      "import": "./node/preview-sheets.mjs"
    },
    "./build-preview-cli": "./node/build-preview-cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "styles",
    "tsconfig.json",
    "LICENSE",
    "SOURCE_PROVENANCE.json",
    "README.md",
    "docs",
    "node",
    "fixtures/composition",
    "NOTICE",
    "SOURCE_LINEAGE.json",
    "SOURCE_PLAN.json",
    "AGENTS.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SOURCE_RECEIPT.json",
    ".attribution.json",
    ".attribution-release.json",
