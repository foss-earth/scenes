    "@foss-earth/cubemap": "0.1.0"
  },
  "peerDependencies": {
    "@foss-earth/ui": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@foss-earth/ui": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/foss-earth/scenes.git"
  },
  "bin": {
    "foss-earth-check-scene": "./node/check-cli.mjs",
    "foss-earth-build-preview-sheets": "./node/build-preview-cli.mjs"
  }
