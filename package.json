    "deps/foss-earth-ci-1db73d1ddb342e348a2c9e8387f7bbc7ebb3225e.tgz"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.tmp/build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "test": "vitest run --maxWorkers=50%",
    "ci": "npm run check:conformance && npm run check:implementation",
    "check:consumer": "tsc -p tsconfig.consumer.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "check:implementation": "npm run lint && npm run typecheck && npm run build && npm test && node scripts/check-public-consumer.mjs && npm run check:consumer",
    "check:conformance": "node node_modules/@foss-earth/ci/bin/conformance.mjs --consumer . --trusted-release .attribution-release.json --output-root build/common-conformance",
    "test:installed-consumer": "node scripts/check-isolated-archive.mjs",
    "check:attribution": "node node_modules/@foss-earth/ci/bin/attribution.mjs --repo . --refs-file build/repository-split/intended-publication-refs.json"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.6",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "typescript-eslint": "8.59.3",
